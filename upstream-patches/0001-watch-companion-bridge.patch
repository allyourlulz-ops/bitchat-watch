new file mode 100644
index 0000000..728cf5e
--- /dev/null
+++ b/localPackages/WatchBridgeKit/Sources/WatchBridgeKit/ChannelProtocol.swift
@@ -0,0 +1,179 @@
+//
+// ChannelProtocol.swift — bitchat-watch "channel chat" (our own protocol, v1)
+//
+// Local channel chat keyed by a short shared channel code. Carried over LAN
+// (Bonjour/TCP), MultipeerConnectivity and — opt-in per channel — tunnelled
+// through the bitchat BLE mesh. See docs/wifi-channel.md for the full spec and
+// the security caveats (a short code is a WEAK secret: anyone who can guess or
+// brute-force it can read and post; not for sensitive use).
+//
+// Envelope (all integers big-endian):
+//   0   4  magic "HKC1"
+//   4   1  version = 1
+//   5   1  ttl (hops remaining, default 5, clamped to 7) — NOT authenticated
+//   6   8  channelID = HKDF(code, info "hkchan/v1/id")[0..8]
+//   14 16  msgID (random)
+//   30 12  nonce (random)
+//   42  n  ChaCha20-Poly1305(key, nonce, aad = bytes[0..5) ‖ bytes[6..30)) ciphertext ‖ 16-byte tag
+// Inner plaintext:
+//   originID(8) ‖ timestampMs(8) ‖ kind(1) ‖ nickLen(1) ‖ nick ‖ body
+//
+// SPDX-License-Identifier: GPL-3.0-or-later
+//
+
+import Foundation
+import CryptoKit
+
+enum ChannelTunnelWire {
+    /// bitchat MessageType value used to tunnel channel envelopes through the BLE
+    /// mesh. Unassigned upstream as of bitchat iOS 04995f68 / Android cc1fb178;
+    /// both stock clients relay unknown broadcast types (see docs/wifi-channel.md).
+    static let bitchatPacketType: UInt8 = 0x7E
+    /// Keep tunnelled envelopes inside one BLE write on typical phone links so
+    /// stock relays don't have to fragment an unknown type.
+    static let maxTunnelledEnvelopeBytes = 400
+}
+
+enum ChannelMessageKind: UInt8, Codable {
+    case text = 1
+    case hello = 2   // presence: nickname only, not bridged, ttl 1
+    case leave = 3
+}
+
+struct ChannelKeys: Equatable {
+    let code: String           // normalized
+    let key: SymmetricKey
+    let channelID: Data        // 8 bytes
+    var channelIDHex: String { channelID.hexEncodedString() }
+
+    static let minimumCodeLength = 4
+
+    /// Normalization: NFKC, trim, lowercase, collapse internal whitespace.
+    static func normalize(_ raw: String) -> String {
+        let nfkc = raw.precomposedStringWithCompatibilityMapping
+        return nfkc.trimmingCharacters(in: .whitespacesAndNewlines).lowercased()
+            .split(whereSeparator: { $0 == " " || $0 == "\t" }).joined(separator: " ")
+    }
+
+    init?(code raw: String) {
+        let code = ChannelKeys.normalize(raw)
+        guard code.count >= ChannelKeys.minimumCodeLength else { return nil }
+        let ikm = SymmetricKey(data: Data(code.utf8))
+        let salt = Data("hkchan/v1/salt".utf8)
+        self.code = code
+        self.key = HKDF<SHA256>.deriveKey(inputKeyMaterial: ikm, salt: salt, info: Data("hkchan/v1/key".utf8), outputByteCount: 32)
+        self.channelID = HKDF<SHA256>.deriveKey(inputKeyMaterial: ikm, salt: salt, info: Data("hkchan/v1/id".utf8), outputByteCount: 8)
+            .withUnsafeBytes { Data($0) }
+    }
+
+    static func == (a: ChannelKeys, b: ChannelKeys) -> Bool { a.code == b.code }
+}
+
+struct ChannelEnvelopeHeader: Equatable {
+    static let magic: [UInt8] = [0x48, 0x4B, 0x43, 0x31] // "HKC1"
+    static let version: UInt8 = 1
+    static let length = 42
+    static let defaultTTL: UInt8 = 5
+    static let maxTTL: UInt8 = 7
+    static let maxEnvelopeBytes = 4096
+
+    var ttl: UInt8
+    let channelID: Data
+    let msgID: Data
+    let nonce: Data
+
+    var msgIDHex: String { msgID.hexEncodedString() }
+
+    static func parse(_ d: Data) -> ChannelEnvelopeHeader? {
+        guard d.count >= length + 16, d.count <= maxEnvelopeBytes else { return nil }
+        let b = [UInt8](d)
+        guard Array(b[0..<4]) == magic, b[4] == version else { return nil }
+        return ChannelEnvelopeHeader(ttl: min(b[5], maxTTL), channelID: Data(b[6..<14]),
+                                     msgID: Data(b[14..<30]), nonce: Data(b[30..<42]))
+    }
+
+    /// Returns the envelope with a new TTL byte (only unauthenticated field).
+    static func withTTL(_ envelope: Data, _ ttl: UInt8) -> Data {
+        var e = envelope
+        e[e.startIndex + 5] = ttl
+        return e
+    }
+
+    static func aad(_ envelope: Data) -> Data {
+        let b = [UInt8](envelope)
+        return Data(b[0..<5] + b[6..<30])
+    }
+}
+
+struct ChannelMessage: Equatable {
+    let channelID: Data
+    let msgID: Data
+    let originID: Data
+    let timestampMs: UInt64
+    let kind: ChannelMessageKind
+    let nickname: String
+    let body: String
+    var ttl: UInt8
+}
+
+enum ChannelCodec {
+    static let maxBodyBytes = 280
+    static let maxNickBytes = 32
+
+    static func seal(keys: ChannelKeys, originID: Data, nickname: String, body: String, kind: ChannelMessageKind,
+                     ttl: UInt8 = ChannelEnvelopeHeader.defaultTTL, timestampMs: UInt64,
+                     msgID: Data? = nil, nonce: Data? = nil) throws -> Data {
+        precondition(originID.count == 8)
+        let nick = Data(nickname.utf8.prefix(maxNickBytes))
+        let text = truncatedUTF8(body, maxBytes: maxBodyBytes)
+        var g = SystemRandomNumberGenerator()
+        let mid = msgID ?? Data((0..<16).map { _ in UInt8.random(in: 0...255, using: &g) })
+        let n = nonce ?? Data((0..<12).map { _ in UInt8.random(in: 0...255, using: &g) })
+        var header = Data(ChannelEnvelopeHeader.magic)
+        header.append(ChannelEnvelopeHeader.version)
+        header.append(min(ttl, ChannelEnvelopeHeader.maxTTL))
+        header.append(keys.channelID)
+        header.append(mid)
+        header.append(n)
+        var plain = Data(originID)
+        for s in stride(from: 56, through: 0, by: -8) { plain.append(UInt8((timestampMs >> UInt64(s)) & 0xff)) }
+        plain.append(kind.rawValue)
+        plain.append(UInt8(nick.count))
+        plain.append(nick)
+        plain.append(text)
+        let box = try ChaChaPoly.seal(plain, using: keys.key, nonce: try ChaChaPoly.Nonce(data: n),
+                                      authenticating: ChannelEnvelopeHeader.aad(header))
+        return header + box.ciphertext + box.tag
+    }
+
+    static func open(_ envelope: Data, keys: ChannelKeys) -> ChannelMessage? {
+        guard let h = ChannelEnvelopeHeader.parse(envelope), h.channelID == keys.channelID else { return nil }
+        let b = [UInt8](envelope)
+        let ct = Data(b[ChannelEnvelopeHeader.length ..< (b.count - 16)])
+        let tag = Data(b[(b.count - 16)...])
+        guard let nonce = try? ChaChaPoly.Nonce(data: h.nonce),
+              let box = try? ChaChaPoly.SealedBox(nonce: nonce, ciphertext: ct, tag: tag),
+              let plain = try? ChaChaPoly.open(box, using: keys.key, authenticating: ChannelEnvelopeHeader.aad(envelope)) else { return nil }
+        let p = [UInt8](plain)
+        guard p.count >= 18 else { return nil }
+        var ts: UInt64 = 0
+        for i in 8..<16 { ts = (ts << 8) | UInt64(p[i]) }
+        guard let kind = ChannelMessageKind(rawValue: p[16]) else { return nil }
+        let nl = Int(p[17])
+        guard p.count >= 18 + nl else { return nil }
+        let nick = String(decoding: p[18 ..< 18 + nl], as: UTF8.self)
+        let body = String(decoding: p[(18 + nl)...], as: UTF8.self)
+        return ChannelMessage(channelID: h.channelID, msgID: h.msgID, originID: Data(p[0..<8]),
+                              timestampMs: ts, kind: kind, nickname: nick, body: body, ttl: h.ttl)
+    }
+
+    static func truncatedUTF8(_ s: String, maxBytes: Int) -> Data {
+        var out = Data()
+        for ch in s {
+            let d = Data(String(ch).utf8)
+            if out.count + d.count > maxBytes { break }
+            out.append(d)
+        }
+        return out
+    }
+}
diff --git a/localPackages/WatchBridgeKit/Sources/WatchBridgeKit/ChannelRouter.swift b/localPackages/WatchBridgeKit/Sources/WatchBridgeKit/ChannelRouter.swift
new file mode 100644
index 0000000..41a4f87
--- /dev/null
+++ b/localPackages/WatchBridgeKit/Sources/WatchBridgeKit/ChannelRouter.swift
@@ -0,0 +1,170 @@
+//
+// ChannelRouter.swift — bitchat-watch channel chat forwarding core
+//
+// One router per device (iPhone companion, Mac tester). It owns channel
+// memberships, the msgID dedup cache, TTL handling and the bitchat-bridge rate
+// limit. Transports (LAN, MultipeerConnectivity, bitchat BLE tunnel) are dumb
+// pipes: they hand raw envelopes to `ingest` and send what `send` asks for.
+//
+// Forwarding rules (docs/wifi-channel.md §5):
+//  * only channels this device has joined are forwarded (others are opaque and dropped)
+//  * every msgID is delivered/forwarded at most once (bounded cache)
+//  * TTL: decremented by 1 per channel hop; not forwarded when it reaches 0/1
+//  * LAN/MPC: forwarded to every other link of both kinds except the arrival link
+//  * bitchat: only if the channel is bridged (opt-in), never back into bitchat,
+//    only `.text`/`.leave`, only envelopes <= ChannelTunnelWire.maxTunnelledEnvelopeBytes,
+//    and through a token bucket (default 6/min, burst 3) shared by all channels
+//
+// Threading: not thread-safe; call from one serial queue.
+//
+// SPDX-License-Identifier: GPL-3.0-or-later
+//
+
+import Foundation
+
+enum ChannelPath: String, Codable, CaseIterable {
+    case lan, mpc, bitchat
+}
+
+struct ChannelLinkRef: Hashable {
+    let path: ChannelPath
+    let id: String
+}
+
+struct ChannelMembership {
+    let keys: ChannelKeys
+    var displayName: String
+    var bridgeToBitchat: Bool
+}
+
+struct TokenBucket {
+    var capacity: Double
+    var refillPerSecond: Double
+    private(set) var tokens: Double
+    private var last: Date
+
+    init(capacity: Double, perMinute: Double, now: Date = Date()) {
+        self.capacity = capacity
+        self.refillPerSecond = perMinute / 60
+        self.tokens = capacity
+        self.last = now
+    }
+
+    mutating func take(now: Date = Date()) -> Bool {
+        tokens = min(capacity, tokens + now.timeIntervalSince(last) * refillPerSecond)
+        last = now
+        guard tokens >= 1 else { return false }
+        tokens -= 1
+        return true
+    }
+}
+
+final class ChannelRouter {
+    enum Event {
+        case message(ChannelMessage, channelName: String, via: ChannelPath, bridged: Bool)
+        case dropped(reason: String)
+    }
+
+    // identity
+    let originID: Data
+    var nickname: String
+
+    // outputs
+    /// Send `envelope` on `path`. `except` = arrival link to skip (nil = all links of that path).
+    var transmit: (_ envelope: Data, _ path: ChannelPath, _ except: ChannelLinkRef?) -> Void = { _, _, _ in }
+    var onEvent: (Event) -> Void = { _ in }
+    var now: () -> Date = { Date() }
+
+    // state
+    private(set) var memberships: [Data: ChannelMembership] = [:]
+    private var seen = BoundedSeenSet(capacity: 4096)
+    var bridgeBucket = TokenBucket(capacity: 3, perMinute: 6)
+    private(set) var bridgedOut = 0
+    private(set) var bridgeDropsRateLimited = 0
+
+    init(originID: Data, nickname: String) {
+        precondition(originID.count == 8)
+        self.originID = originID
+        self.nickname = nickname
+    }
+
+    // MARK: membership
+
+    @discardableResult
+    func join(code: String, displayName: String? = nil, bridge: Bool = false) -> ChannelKeys? {
+        guard let keys = ChannelKeys(code: code) else { return nil }
+        memberships[keys.channelID] = ChannelMembership(keys: keys, displayName: displayName ?? "#\(keys.code)", bridgeToBitchat: bridge)
+        return keys
+    }
+
+    func leave(channelID: Data) {
+        if let m = memberships[channelID] { _ = try? sendRaw(m, kind: .leave, body: "", ttl: 1) }
+        memberships.removeValue(forKey: channelID)
+    }
+
+    func setBridge(_ on: Bool, channelID: Data) { memberships[channelID]?.bridgeToBitchat = on }
+
+    /// Hex channel IDs advertised in Bonjour TXT / MPC discoveryInfo.
+    var advertisedChannelIDs: [String] { memberships.keys.map { $0.hexEncodedString() }.sorted() }
+
+    // MARK: outbound
+
+    @discardableResult
+    func send(text: String, channelID: Data, ttl: UInt8 = ChannelEnvelopeHeader.defaultTTL) -> ChannelMessage? {
+        guard let m = memberships[channelID] else { return nil }
+        return try? sendRaw(m, kind: .text, body: text, ttl: ttl)
+    }
+
+    func sendHello(channelID: Data) {
+        guard let m = memberships[channelID] else { return }
+        _ = try? sendRaw(m, kind: .hello, body: "", ttl: 1)
+    }
+
+    private func sendRaw(_ m: ChannelMembership, kind: ChannelMessageKind, body: String, ttl: UInt8) throws -> ChannelMessage? {
+        let env = try ChannelCodec.seal(keys: m.keys, originID: originID, nickname: nickname, body: body, kind: kind,
+                                        ttl: ttl, timestampMs: unixMillis(now()))
+        guard let h = ChannelEnvelopeHeader.parse(env) else { return nil }
+        seen.insert(h.msgIDHex)
+        transmit(env, .lan, nil)
+        transmit(env, .mpc, nil)
+        if m.bridgeToBitchat && kind != .hello { bridgeOut(env) }
+        return ChannelCodec.open(env, keys: m.keys)
+    }
+
+    // MARK: inbound
+
+    func ingest(_ envelope: Data, from link: ChannelLinkRef) {
+        guard let h = ChannelEnvelopeHeader.parse(envelope) else { onEvent(.dropped(reason: "not a channel envelope")); return }
+        guard let m = memberships[h.channelID] else { return } // not our channel: opaque, ignore
+        guard !seen.contains(h.msgIDHex) else { return }
+        guard let msg = ChannelCodec.open(envelope, keys: m.keys) else {
+            onEvent(.dropped(reason: "auth failed (wrong code or tampered)"))
+            return
+        }
+        seen.insert(h.msgIDHex)
+        if msg.originID == originID { return } // our own message looped back
+        onEvent(.message(msg, channelName: m.displayName, via: link.path, bridged: link.path == .bitchat))
+
+        // forward
+        guard msg.kind != .hello, h.ttl > 1 else { return }
+        let fwd = ChannelEnvelopeHeader.withTTL(envelope, h.ttl - 1)
+        for path in [ChannelPath.lan, .mpc] {
+            transmit(fwd, path, link.path == path ? link : nil)
+        }
+        if m.bridgeToBitchat && link.path != .bitchat { bridgeOut(fwd) }
+    }
+
+    private func bridgeOut(_ envelope: Data) {
+        guard envelope.count <= ChannelTunnelWire.maxTunnelledEnvelopeBytes else {
+            onEvent(.dropped(reason: "too large to bridge into bitchat"))
+            return
+        }
+        guard bridgeBucket.take(now: now()) else {
+            bridgeDropsRateLimited += 1
+            onEvent(.dropped(reason: "bitchat bridge rate limit"))
+            return
+        }
+        bridgedOut += 1
+        transmit(envelope, .bitchat, nil)
+    }
+}
diff --git a/localPackages/WatchBridgeKit/Sources/WatchBridgeKit/ChannelSupport.swift b/localPackages/WatchBridgeKit/Sources/WatchBridgeKit/ChannelSupport.swift
new file mode 100644
index 0000000..f667c4f
--- /dev/null
+++ b/localPackages/WatchBridgeKit/Sources/WatchBridgeKit/ChannelSupport.swift
@@ -0,0 +1,28 @@
+//
+// ChannelSupport.swift — bitchat-watch
+// Small helpers shared by the channel core and the bitchat leaf engine
+// (kept dependency-free so the iPhone bridge package can compile it alone).
+// SPDX-License-Identifier: GPL-3.0-or-later
+//
+
+import Foundation
+
+func unixMillis(_ d: Date) -> UInt64 { UInt64(max(0, d.timeIntervalSince1970) * 1000) }
+
+/// FIFO-bounded set for dedup.
+struct BoundedSeenSet {
+    private var set = Set<String>()
+    private var order: [String] = []
+    let capacity: Int
+    init(capacity: Int) { self.capacity = capacity }
+    func contains(_ s: String) -> Bool { set.contains(s) }
+    mutating func insert(_ s: String) {
+        guard set.insert(s).inserted else { return }
+        order.append(s)
+        if order.count > capacity {
+            let drop = order.count - capacity
+            for old in order.prefix(drop) { set.remove(old) }
+            order.removeFirst(drop)
+        }
+    }
+}
