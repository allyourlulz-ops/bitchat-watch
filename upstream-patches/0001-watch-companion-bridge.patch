@@ -0,0 +1,33 @@
+//
+// Data+SHA256.swift
+// BitFoundation
+//
+// This is free and unencumbered software released into the public domain.
+// For more information, see <https://unlicense.org>
+//
+
+import struct Foundation.Data
+import CryptoKit
+
+extension Data {
+    /// Returns the hex representation of SHA256 hash
+    func sha256Fingerprint() -> String {
+        // Implementation matches existing fingerprint generation in NoiseEncryptionService
+        sha256Hash().hexEncodedString()
+    }
+
+    /// Returns the SHA256 hash wrapped in Data
+    func sha256Hash() -> Data {
+        Data(sha256Digest)
+    }
+
+    func sha256Hex() -> String {
+        sha256Digest.map { String(format: "%02x", $0) }.joined()
+    }
+}
+
+private extension Data {
+    var sha256Digest: SHA256.Digest {
+        SHA256.hash(data: self)
+    }
+}
diff --git a/localPackages/WatchBridgeKit/Sources/WatchBridgeKit/LANChannelTransport.swift b/localPackages/WatchBridgeKit/Sources/WatchBridgeKit/LANChannelTransport.swift
new file mode 100644
index 0000000..28ff277
--- /dev/null
+++ b/localPackages/WatchBridgeKit/Sources/WatchBridgeKit/LANChannelTransport.swift
@@ -0,0 +1,142 @@
+//
+// LANChannelTransport.swift — bitchat-watch iPhone companion
+//
+// Channel chat over the local network (no internet): Bonjour `_hkchan._tcp`
+// via Network.framework. Each device advertises one service whose TXT record
+// carries `v=1` and `c=<comma-separated channel-ID hex>` (8-byte HKDF-derived
+// IDs, never the codes). Devices sharing at least one channel connect over TCP;
+// to avoid duplicate pairs only the side with the lexicographically smaller
+// instance name dials. Frames: 4-byte big-endian length + channel envelope
+// (≤ 4096 bytes). Envelopes are already ChaCha20-Poly1305 sealed with the
+// channel key, so TCP carries no extra TLS.
+//
+// SPDX-License-Identifier: GPL-3.0-or-later
+//
+
+import Foundation
+import Network
+
+@MainActor
+final class LANChannelTransport {
+    static let serviceType = "_hkchan._tcp"
+    let instanceName = "hk-" + UUID().uuidString.prefix(12).lowercased()
+
+    var onEnvelope: (Data, String) -> Void = { _, _ in }     // (envelope, linkID)
+    var onPeersChanged: (Int) -> Void = { _ in }
+
+    private var listener: NWListener?
+    private var browser: NWBrowser?
+    private var connections: [String: NWConnection] = [:]
+    private var buffers: [String: Data] = [:]
+    private var dialed: Set<String> = []
+    private var channelIDs: [String] = []
+    private let queue = DispatchQueue.main
+
+    func update(channelIDs ids: [String]) {
+        guard ids != channelIDs else { return }
+        channelIDs = ids
+        restart()
+    }
+
+    func stop() {
+        listener?.cancel(); listener = nil
+        browser?.cancel(); browser = nil
+        connections.values.forEach { $0.cancel() }
+        connections.removeAll(); buffers.removeAll(); dialed.removeAll()
+        onPeersChanged(0)
+    }
+
+    func send(_ envelope: Data, except: String?) {
+        guard envelope.count <= ChannelEnvelopeHeader.maxEnvelopeBytes else { return }
+        var framed = Data([UInt8(envelope.count >> 24 & 0xff), UInt8(envelope.count >> 16 & 0xff),
+                           UInt8(envelope.count >> 8 & 0xff), UInt8(envelope.count & 0xff)])
+        framed.append(envelope)
+        for (id, c) in connections where id != except {
+            c.send(content: framed, completion: .contentProcessed { _ in })
+        }
+    }
+
+    var peerCount: Int { connections.count }
+
+    private func restart() {
+        stop()
+        guard !channelIDs.isEmpty else { return }
+        do {
+            let l = try NWListener(using: .tcp)
+            var txt = NWTXTRecord()
+            txt["v"] = "1"
+            txt["c"] = channelIDs.prefix(16).joined(separator: ",")
+            l.service = NWListener.Service(name: instanceName, type: Self.serviceType, domain: nil, txtRecord: txt)
+            l.newConnectionHandler = { [weak self] conn in
+                MainActor.assumeIsolated { self?.adopt(conn, id: "in-\(UUID().uuidString.prefix(8))") }
+            }
+            l.start(queue: queue)
+            listener = l
+        } catch {
+            SecureLogger.error("LAN listener failed: \(error)")
+        }
+        let b = NWBrowser(for: .bonjourWithTXTRecord(type: Self.serviceType, domain: nil), using: .tcp)
+        b.browseResultsChangedHandler = { [weak self] results, _ in
+            MainActor.assumeIsolated { self?.handle(results) }
+        }
+        b.start(queue: queue)
+        browser = b
+    }
+
+    private func handle(_ results: Set<NWBrowser.Result>) {
+        for r in results {
+            guard case .service(let name, _, _, _) = r.endpoint, name != instanceName, !dialed.contains(name) else { continue }
+            guard case .bonjour(let txt) = r.metadata, txt["v"] == "1" else { continue }
+            let theirs = Set((txt["c"] ?? "").split(separator: ",").map(String.init))
+            guard !theirs.isDisjoint(with: channelIDs), instanceName < name else { continue }
+            dialed.insert(name)
+            adopt(NWConnection(to: r.endpoint, using: .tcp), id: "out-\(name)")
+        }
+    }
+
+    private func adopt(_ c: NWConnection, id: String) {
+        connections[id] = c
+        c.stateUpdateHandler = { [weak self] state in
+            MainActor.assumeIsolated {
+                switch state {
+                case .ready: self?.onPeersChanged(self?.connections.count ?? 0)
+                case .failed, .cancelled: self?.drop(id)
+                default: break
+                }
+            }
+        }
+        c.start(queue: queue)
+        receive(c, id: id)
+    }
+
+    private func drop(_ id: String) {
+        connections.removeValue(forKey: id)?.cancel()
+        buffers.removeValue(forKey: id)
+        if id.hasPrefix("out-") { dialed.remove(String(id.dropFirst(4))) }
+        onPeersChanged(connections.count)
+    }
+
+    private func receive(_ c: NWConnection, id: String) {
+        c.receive(minimumIncompleteLength: 1, maximumLength: 16 * 1024) { [weak self] data, _, done, error in
+            MainActor.assumeIsolated {
+                guard let self = self else { return }
+                if let d = data, !d.isEmpty { self.consume(d, id: id) }
+                if done || error != nil { self.drop(id); return }
+                self.receive(c, id: id)
+            }
+        }
+    }
+
+    private func consume(_ d: Data, id: String) {
+        var buf = (buffers[id] ?? Data()) + d
+        while buf.count >= 4 {
+            let b = [UInt8](buf.prefix(4))
+            let len = Int(b[0]) << 24 | Int(b[1]) << 16 | Int(b[2]) << 8 | Int(b[3])
+            guard len > 0, len <= ChannelEnvelopeHeader.maxEnvelopeBytes else { drop(id); return }
+            guard buf.count >= 4 + len else { break }
+            onEnvelope(Data(buf.subdata(in: buf.startIndex + 4 ..< buf.startIndex + 4 + len)), id)
+            buf = Data(buf.dropFirst(4 + len))
+        }
+        buffers[id] = buf
+    }
+}
diff --git a/localPackages/WatchBridgeKit/Sources/WatchBridgeKit/MPCChannelTransport.swift b/localPackages/WatchBridgeKit/Sources/WatchBridgeKit/MPCChannelTransport.swift
new file mode 100644
index 0000000..c762dfc
--- /dev/null
+++ b/localPackages/WatchBridgeKit/Sources/WatchBridgeKit/MPCChannelTransport.swift
@@ -0,0 +1,118 @@
+//
+// MPCChannelTransport.swift — bitchat-watch iPhone companion
+//
+// Channel chat over MultipeerConnectivity (router-free peer-to-peer Wi-Fi /
+// Bluetooth between Apple devices). Service type "hk-chan". discoveryInfo
+// carries `v=1` and `c=<comma-separated channel-ID hex>` — HKDF-derived IDs,
+// never the channel code. Devices sharing a channel invite each other (only
+// the smaller displayName invites, to avoid crossed invitations); sessions use
+// encryptionPreference .required. Each MPC message is exactly one envelope.
+//
+// Limits: Apple-only; iOS suspends MPC when the app is backgrounded (links
+// drop and come back on foreground); discoveryInfo should stay small (≤ ~400
+// bytes), so at most 16 channel IDs are advertised.
+//
+// SPDX-License-Identifier: GPL-3.0-or-later
+//
+
+import Foundation
+import MultipeerConnectivity
+
+@MainActor
+final class MPCChannelTransport: NSObject {
+    static let serviceType = "hk-chan"   // ≤15 chars, lowercase letters/digits/hyphen
+    private let me = MCPeerID(displayName: "hk-" + UUID().uuidString.prefix(8).lowercased())
+    private var session: MCSession!
+    private var advertiser: MCNearbyServiceAdvertiser?
+    private var browser: MCNearbyServiceBrowser?
+    private var channelIDs: [String] = []
+
+    var onEnvelope: (Data, String) -> Void = { _, _ in }
+    var onPeersChanged: (Int) -> Void = { _ in }
+
+    override init() {
+        super.init()
+        session = MCSession(peer: me, securityIdentity: nil, encryptionPreference: .required)
+        session.delegate = self
+    }
+
+    func update(channelIDs ids: [String]) {
+        guard ids != channelIDs else { return }
+        channelIDs = ids
+        restart()
+    }
+
+    func stop() {
+        advertiser?.stopAdvertisingPeer(); advertiser = nil
+        browser?.stopBrowsingForPeers(); browser = nil
+        session.disconnect()
+        onPeersChanged(0)
+    }
+
+    var peerCount: Int { session.connectedPeers.count }
+
+    func send(_ envelope: Data, except: String?) {
+        let targets = session.connectedPeers.filter { $0.displayName != except }
+        guard !targets.isEmpty else { return }
+        try? session.send(envelope, toPeers: targets, with: .reliable)
+    }
+
+    private var info: [String: String] { ["v": "1", "c": channelIDs.prefix(16).joined(separator: ",")] }
+
+    private func restart() {
+        advertiser?.stopAdvertisingPeer(); browser?.stopBrowsingForPeers()
+        guard !channelIDs.isEmpty else { stop(); return }
+        let a = MCNearbyServiceAdvertiser(peer: me, discoveryInfo: info, serviceType: Self.serviceType)
+        a.delegate = self
+        a.startAdvertisingPeer()
+        advertiser = a
+        let b = MCNearbyServiceBrowser(peer: me, serviceType: Self.serviceType)
+        b.delegate = self
+        b.startBrowsingForPeers()
+        browser = b
+    }
+
+    private func sharesChannel(_ csv: String?) -> Bool {
+        let theirs = Set((csv ?? "").split(separator: ",").map(String.init))
+        return !theirs.isDisjoint(with: channelIDs)
+    }
+}
+
+extension MPCChannelTransport: MCNearbyServiceBrowserDelegate {
+    nonisolated func browser(_ browser: MCNearbyServiceBrowser, foundPeer peerID: MCPeerID, withDiscoveryInfo info: [String: String]?) {
+        let csv = info?["c"], v = info?["v"]
+        Task { @MainActor in
+            guard v == "1", self.sharesChannel(csv), self.me.displayName < peerID.displayName,
+                  !self.session.connectedPeers.contains(peerID) else { return }
+            let ctx = self.channelIDs.joined(separator: ",").data(using: .utf8)
+            browser.invitePeer(peerID, to: self.session, withContext: ctx, timeout: 15)
+        }
+    }
+    nonisolated func browser(_ browser: MCNearbyServiceBrowser, lostPeer peerID: MCPeerID) {}
+}
+
+extension MPCChannelTransport: MCNearbyServiceAdvertiserDelegate {
+    nonisolated func advertiser(_ advertiser: MCNearbyServiceAdvertiser, didReceiveInvitationFromPeer peerID: MCPeerID,
+                                withContext context: Data?, invitationHandler: @escaping (Bool, MCSession?) -> Void) {
+        let csv = context.flatMap { String(data: $0, encoding: .utf8) }
+        nonisolated(unsafe) let handler = invitationHandler
+        Task { @MainActor in
+            let ok = self.sharesChannel(csv)
+            handler(ok, ok ? self.session : nil)
+        }
+    }
+}
+
+extension MPCChannelTransport: MCSessionDelegate {
+    nonisolated func session(_ session: MCSession, peer peerID: MCPeerID, didChange state: MCSessionState) {
+        let n = session.connectedPeers.count
+        Task { @MainActor in self.onPeersChanged(n) }
+    }
+    nonisolated func session(_ session: MCSession, didReceive data: Data, fromPeer peerID: MCPeerID) {
+        let name = peerID.displayName
+        Task { @MainActor in self.onEnvelope(data, name) }
+    }
+    nonisolated func session(_ session: MCSession, didReceive stream: InputStream, withName streamName: String, fromPeer peerID: MCPeerID) {}
+    nonisolated func session(_ session: MCSession, didStartReceivingResourceWithName resourceName: String, fromPeer peerID: MCPeerID, with progress: Progress) {}
+    nonisolated func session(_ session: MCSession, didFinishReceivingResourceWithName resourceName: String, fromPeer peerID: MCPeerID, at localURL: URL?, withError error: Error?) {}
+}
