@@ -0,0 +1,64 @@
+//
+// CompanionProtocol.swift — bitchat-watch
+//
+// Messages exchanged between the watch app and the iPhone companion bridge over
+// WatchConnectivity. Shared verbatim by both sides. Each message is JSON in a
+// WCSession message dictionary under key "hk" (sendMessage when reachable,
+// transferUserInfo as a queued fallback for watch→phone sends). The phone also
+// keeps an applicationContext snapshot so the watch has something to show the
+// moment it launches.
+//
+// SPDX-License-Identifier: GPL-3.0-or-later
+//
+
+import Foundation
+
+enum CompanionWire {
+    static let key = "hk"
+    static let version = 1
+    static let contextKey = "hkSnapshot"
+}
+
+struct CompanionSnapshot: Codable, Equatable {
+    var phoneNickname: String
+    var people: [UnifiedPerson]          // network == .bitchatPhone
+    var rooms: [RoomInfo]                // bitchat public + joined channel-chat channels
+    var recent: [UnifiedMessage]         // last N messages across rooms/DMs
+    var bridgeAvailable: Bool            // phone can tunnel channel chat into bitchat
+}
+
+enum CompanionMessage: Codable, Equatable {
+    // phone -> watch
+    case snapshot(CompanionSnapshot)
+    case message(UnifiedMessage)
+    case people([UnifiedPerson])
+    case rooms([RoomInfo])
+    case delivery(messageID: String, state: DeliveryState)
+    case error(String)
+
+    // watch -> phone
+    case requestSnapshot
+    case sendRoom(conversation: ConversationID, text: String, clientID: String)
+    case sendDirect(peerKey: String, text: String, clientID: String)
+    case joinChannel(code: String, bridge: Bool)
+    case leaveChannel(channelIDHex: String)
+    case setChannelBridge(channelIDHex: String, enabled: Bool)
+    case toggleFavorite(peerKey: String)
+
+    func encodeToDictionary() -> [String: Any] {
+        let data = (try? JSONEncoder().encode(CompanionEnvelope(v: CompanionWire.version, m: self))) ?? Data()
+        return [CompanionWire.key: data]
+    }
+
+    static func decode(fromDictionary d: [String: Any]) -> CompanionMessage? {
+        guard let data = d[CompanionWire.key] as? Data,
+              let env = try? JSONDecoder().decode(CompanionEnvelope.self, from: data),
+              env.v == CompanionWire.version else { return nil }
+        return env.m
+    }
+}
+
+struct CompanionEnvelope: Codable, Equatable {
+    let v: Int
+    let m: CompanionMessage
+}
diff --git a/localPackages/WatchBridgeKit/Sources/WatchBridgeKit/Data+Hex.swift b/localPackages/WatchBridgeKit/Sources/WatchBridgeKit/Data+Hex.swift
new file mode 100644
index 0000000..e116ba1
--- /dev/null
+++ b/localPackages/WatchBridgeKit/Sources/WatchBridgeKit/Data+Hex.swift
@@ -0,0 +1,77 @@
+//
+// Data+Hex.swift
+// BitFoundation
+//
+// This is free and unencumbered software released into the public domain.
+// For more information, see <https://unlicense.org>
+//
+
+import struct Foundation.Data
+
+extension Data {
+    /// Lowercase hex, two digits per byte, no separators.
+    ///
+    /// Table lookup instead of `String(format:)` per byte: Nostr public keys
+    /// are re-encoded on hot paths (geochat roster rebuilds touch one per
+    /// participant), and the formatted version cost ~14 µs per 32-byte key.
+    func hexEncodedString() -> String {
+        if self.isEmpty {
+            return ""
+        }
+        return String(unsafeUninitializedCapacity: count * 2) { buffer in
+            var index = 0
+            for byte in self {
+                buffer[index] = Self.lowercaseHexDigits[Int(byte >> 4)]
+                buffer[index + 1] = Self.lowercaseHexDigits[Int(byte & 0x0F)]
+                index += 2
+            }
+            return index
+        }
+    }
+
+    private static let lowercaseHexDigits: [UInt8] = Array("0123456789abcdef".utf8)
+
+    /// Initialize Data from a hex string.
+    /// - Parameter hexString: A hex string, optionally prefixed with "0x" or "0X".
+    ///   Whitespace is trimmed. Must have even length after prefix removal.
+    /// - Returns: nil if the string has odd length or contains invalid hex characters.
+    init?(hexString: String) {
+        var hex = hexString.trimmed
+
+        // Remove optional 0x prefix
+        if hex.hasPrefix("0x") || hex.hasPrefix("0X") {
+            hex = String(hex.dropFirst(2))
+        }
+
+        // Reject odd-length strings
+        guard hex.count % 2 == 0 else {
+            return nil
+        }
+
+        // Reject empty strings
+        guard !hex.isEmpty else {
+            self = Data()
+            return
+        }
+
+        let len = hex.count / 2
+        var data = Data(capacity: len)
+        var index = hex.startIndex
+
+        for _ in 0..<len {
+            let nextIndex = hex.index(index, offsetBy: 2)
+            let pair = hex[index..<nextIndex]
+            // UInt8(_:radix:) accepts a leading sign, so "+f" parses as 0x0f.
+            // That gives an identity-bearing hex string a second spelling which
+            // decodes to the same bytes, so require two hex digits first.
+            guard pair.allSatisfy(\.isHexDigit),
+                  let byte = UInt8(pair, radix: 16) else {
+                return nil
+            }
+            data.append(byte)
+            index = nextIndex
+        }
+
+        self = data
+    }
+}
diff --git a/localPackages/WatchBridgeKit/Sources/WatchBridgeKit/Data+SHA256.swift b/localPackages/WatchBridgeKit/Sources/WatchBridgeKit/Data+SHA256.swift
