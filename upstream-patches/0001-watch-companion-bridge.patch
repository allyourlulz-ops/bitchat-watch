diff --git a/localPackages/WatchBridgeKit/Sources/WatchBridgeKit/UnifiedModels.swift b/localPackages/WatchBridgeKit/Sources/WatchBridgeKit/UnifiedModels.swift
new file mode 100644
index 0000000..949ad2c
--- /dev/null
+++ b/localPackages/WatchBridgeKit/Sources/WatchBridgeKit/UnifiedModels.swift
@@ -0,0 +1,91 @@
+//
+// UnifiedModels.swift — bitchat-watch
+//
+// Network-neutral models behind the watch's single inbox. Every conversation,
+// person and message carries its NetworkKind so the UI can always label which
+// network (and which radio / phone path) it belongs to. Nothing is merged
+// across networks: the same human on bitchat and Meshtastic is two people.
+//
+// SPDX-License-Identifier: GPL-3.0-or-later
+//
+
+import Foundation
+
+enum NetworkKind: String, Codable, CaseIterable, Hashable {
+    case bitchat          // direct BLE mesh from the watch (leaf)
+    case bitchatPhone     // bitchat via the paired iPhone (WatchConnectivity)
+    case meshtastic       // Meshtastic LoRa radio over BLE
+    case meshcore         // MeshCore LoRa companion radio over BLE
+    case channel          // local channel chat (LAN/MPC/bridge) via the iPhone
+
+    var shortLabel: String {
+        switch self {
+        case .bitchat: return "bitchat"
+        case .bitchatPhone: return "bitchat·📱"
+        case .meshtastic: return "Meshtastic"
+        case .meshcore: return "MeshCore"
+        case .channel: return "Wi-Fi ch"
+        }
+    }
+    var badge: String {
+        switch self {
+        case .bitchat: return "BC"
+        case .bitchatPhone: return "BC📱"
+        case .meshtastic: return "MT"
+        case .meshcore: return "MC"
+        case .channel: return "CH"
+        }
+    }
+}
+
+struct ConversationID: Hashable, Codable, CustomStringConvertible {
+    enum Scope: String, Codable { case room, direct }
+    let network: NetworkKind
+    let scope: Scope
+    /// room: channel key ("public", Meshtastic channel index, MeshCore channel index, channel-chat ID hex)
+    /// direct: peer key (bitchat peerID hex, "!nodenum", MeshCore pubkey prefix hex)
+    let key: String
+
+    static func room(_ n: NetworkKind, _ key: String) -> ConversationID { .init(network: n, scope: .room, key: key) }
+    static func direct(_ n: NetworkKind, _ key: String) -> ConversationID { .init(network: n, scope: .direct, key: key) }
+    var description: String { "\(network.rawValue)/\(scope.rawValue)/\(key)" }
+}
+
+enum DeliveryState: String, Codable {
+    case sending, sent, delivered, read, failed, received
+}
+
+struct UnifiedMessage: Codable, Identifiable, Equatable {
+    let id: String
+    let conversation: ConversationID
+    let senderName: String
+    let senderKey: String
+    let text: String
+    let timestamp: Date
+    let outgoing: Bool
+    var state: DeliveryState
+    /// Arrived (or left) through a bridge hop, e.g. a channel message tunnelled via bitchat.
+    var bridged: Bool = false
+    /// Free-form path note for the detail view ("LAN", "MPC", "bitchat bridge", "SNR 6.5").
+    var via: String? = nil
+}
+
+struct UnifiedPerson: Codable, Identifiable, Hashable {
+    var id: String { "\(network.rawValue):\(key)" }
+    let network: NetworkKind
+    let key: String
+    var displayName: String
+    var detail: String           // fingerprint prefix, node id, RSSI/SNR, hops
+    var isOnline: Bool
+    var isFavorite: Bool
+    var canMessage: Bool
+    var secureSession: Bool = false
+}
+
+struct RoomInfo: Codable, Hashable, Identifiable {
+    var id: ConversationID { conversation }
+    let conversation: ConversationID
+    var title: String
+    var bridged: Bool = false     // channel chat: bridged into bitchat (opt-in)
+    var memberCount: Int? = nil
+}
diff --git a/localPackages/WatchBridgeKit/Sources/WatchBridgeKit/UpstreamShims.swift b/localPackages/WatchBridgeKit/Sources/WatchBridgeKit/UpstreamShims.swift
new file mode 100644
index 0000000..4e2ee2e
--- /dev/null
+++ b/localPackages/WatchBridgeKit/Sources/WatchBridgeKit/UpstreamShims.swift
@@ -0,0 +1,101 @@
+//
+// UpstreamShims.swift — bitchat-watch
+//
+// Minimal stand-ins for upstream bitchat dependencies (BitLogger.SecureLogger,
+// BitFoundation.KeychainManagerProtocol, TransportConfig) so the vendored
+// protocol/Noise files in ../Upstream and ../Noise compile unchanged inside the
+// watch app target, the iOS bridge, and the Linux typecheck harness.
+//
+// SPDX-License-Identifier: GPL-3.0-or-later (this file); the vendored files keep
+// their original Unlicense headers.
+//
+
+import Foundation
+#if canImport(os)
+import os
+#endif
+
+/// Log categories used by the vendored files.
+enum LogCategory: String {
+    case session, security, encryption, noise, general
+}
+
+/// Structured security events used by vendored NoiseSession / NoiseEncryptionService.
+enum SecurityEvent {
+    case handshakeStarted(peerID: String)
+    case handshakeCompleted(peerID: String)
+    case handshakeFailed(peerID: String, error: String)
+    case sessionExpired(peerID: String)
+    case authenticationFailed(peerID: String)
+
+    var message: String {
+        switch self {
+        case .handshakeStarted(let p): return "Noise handshake started with \(p.prefix(8))…"
+        case .handshakeCompleted(let p): return "Noise handshake completed with \(p.prefix(8))…"
+        case .handshakeFailed(let p, let e): return "Noise handshake failed with \(p.prefix(8))…: \(e)"
+        case .sessionExpired(let p): return "Noise session expired for \(p.prefix(8))…"
+        case .authenticationFailed(let p): return "Authentication failed for \(p.prefix(8))…"
+        }
+    }
+}
+
+/// Tiny logger compatible with the call shapes used by the vendored files.
+/// Never logs message contents or key material (the vendored callers don't pass any).
+enum SecureLogger {
+    nonisolated(unsafe) static var sink: ((String) -> Void)? = nil
+    #if DEBUG
+    nonisolated(unsafe) static var minimumLevel = 0
+    #else
+    nonisolated(unsafe) static var minimumLevel = 2
+    #endif
+
+    private static func emit(_ level: Int, _ tag: String, _ text: @autoclosure () -> String, _ category: LogCategory) {
+        guard level >= minimumLevel else { return }
+        let line = "[\(tag)][\(category.rawValue)] \(text())"
+        if let sink = sink { sink(line); return }
+        #if canImport(os)
+        os_log("%{public}@", line)
+        #else
+        print(line)
+        #endif
+    }
+
+    static func debug(_ text: @autoclosure () -> String, category: LogCategory = .general) { emit(0, "D", text(), category) }
+    static func info(_ text: @autoclosure () -> String, category: LogCategory = .general) { emit(1, "I", text(), category) }
+    static func warning(_ text: @autoclosure () -> String, category: LogCategory = .general) { emit(2, "W", text(), category) }
+    static func error(_ text: @autoclosure () -> String, category: LogCategory = .general) { emit(3, "E", text(), category) }
+
+    static func debug(_ event: SecurityEvent) { emit(0, "D", event.message, .security) }
+    static func info(_ event: SecurityEvent) { emit(1, "I", event.message, .security) }
+    static func warning(_ event: SecurityEvent) { emit(2, "W", event.message, .security) }
+    static func error(_ event: SecurityEvent) { emit(3, "E", event.message, .security) }
+}
+
+/// Subset of BitFoundation.KeychainManagerProtocol needed by NoiseProtocol/NoiseSession.
+protocol KeychainManagerProtocol: AnyObject {
+    func secureClear(_ data: inout Data)
+}
+
+/// Default zeroizer (best effort: Swift CoW means older copies may survive).
+final class MemoryZeroizer: KeychainManagerProtocol, @unchecked Sendable {
+    static let shared = MemoryZeroizer()
+    func secureClear(_ data: inout Data) {
+        guard !data.isEmpty else { return }
+        data.resetBytes(in: 0..<data.count)
+        data = Data()
+    }
+}
+
+/// Constants mirrored from upstream bitchat Services/TransportConfig.swift @ 04995f68.
+enum TransportConfig {
+    static let bleDefaultFragmentSize: Int = 469
+    static let messageTTLDefault: UInt8 = 7
+    static let bleNotificationAssemblerHardCapBytes: Int = 8 * 1024 * 1024
+    static let bleAssemblerStallResetMs: Int = 250
+    static let bleFragmentLifetimeSeconds: TimeInterval = 30.0
+    static let bleFragmentSpacingMs: Int = 30
+    static let bleFragmentSpacingDirectedMs: Int = 25
+    /// Upstream accepts public messages up to the gossip-sync window; we use the
+    /// announce freshness window (900 s) for announces and this for messages.
+    static let syncPublicMessageMaxAgeSeconds: TimeInterval = 6 * 60 * 60
+}
diff --git a/localPackages/WatchBridgeKit/Sources/WatchBridgeKit/WatchBridgeHub.swift b/localPackages/WatchBridgeKit/Sources/WatchBridgeKit/WatchBridgeHub.swift
new file mode 100644
index 0000000..df4fda5
--- /dev/null
+++ b/localPackages/WatchBridgeKit/Sources/WatchBridgeKit/WatchBridgeHub.swift
@@ -0,0 +1,131 @@
+//
+// WatchBridgeHub.swift — bitchat-watch iPhone companion bridge
+//
+// The phone side of companion mode. A WCSessionDelegate that:
+//   * forwards the phone's bitchat chat (any CompanionChatSource — the patched
+//     upstream ChatViewModel adapter, or the standalone host's leaf engine) to
+//     the watch as NetworkKind.bitchatPhone,
+//   * runs ChannelChatService (LAN + MPC + optional bitchat bridge) and shows
+//     it on the watch as NetworkKind.channel,
+//   * executes watch requests (send, join/leave channel, bridge toggle, favorite).
+// It is additive: the host app only has to create it and keep a reference.
+//
+// SPDX-License-Identifier: GPL-3.0-or-later
+//
+
+import Foundation
+import WatchConnectivity
+
+/// What the bridge needs from the phone's bitchat stack.
+@MainActor
+protocol CompanionChatSource: AnyObject {
+    var nickname: String { get }
+    var people: [UnifiedPerson] { get }            // network = .bitchatPhone
+    var recentMessages: [UnifiedMessage] { get }   // network = .bitchatPhone
+    /// Called by the source when something changed (bridge then pushes a delta / snapshot).
+    var onMessage: ((UnifiedMessage) -> Void)? { get set }
+    var onPeopleChanged: (() -> Void)? { get set }
+    func sendPublic(_ text: String) -> UnifiedMessage?
+    func sendPrivate(_ text: String, peerKey: String) -> UnifiedMessage?
+    func toggleFavorite(peerKey: String)
+    /// Opaque channel-tunnel support (nil if the bitchat stack can't send/receive type 0x7E).
+    var tunnelSend: ((Data, UInt8) -> Void)? { get }
+    var onTunnelReceive: ((Data, String) -> Void)? { get set }
+}
+
+@MainActor
+final class WatchBridgeHub: NSObject {
+    let source: CompanionChatSource
+    let channels: ChannelChatService
+    private var session: WCSession? { WCSession.isSupported() ? WCSession.default : nil }
+    private var contextTimer: Timer?
+
+    init(source: CompanionChatSource) {
+        self.source = source
+        self.channels = ChannelChatService(nickname: source.nickname)
+        super.init()
+        channels.bitchatTunnelSend = source.tunnelSend
+        source.onTunnelReceive = { [weak self] env, peer in self?.channels.ingestFromBitchat(env, from: peer) }
+        source.onMessage = { [weak self] m in self?.push(.message(m)) }
+        source.onPeopleChanged = { [weak self] in
+            guard let self = self else { return }
+            self.push(.people(self.source.people)); self.scheduleContextUpdate()
+        }
+        channels.onMessage = { [weak self] m in self?.push(.message(m)) }
+        channels.onChange = { [weak self] in
+            guard let self = self else { return }
+            self.push(.rooms(self.channels.rooms)); self.scheduleContextUpdate()
+        }
+    }
+
+    func start() {
+        guard let s = session else { return }
+        s.delegate = self
+        s.activate()
+    }
+
+    func snapshot() -> CompanionSnapshot {
+        let publicRoom = RoomInfo(conversation: .room(.bitchatPhone, "public"), title: "Mesh · via iPhone")
+        return CompanionSnapshot(phoneNickname: source.nickname, people: source.people,
+                                 rooms: [publicRoom] + channels.rooms,
+                                 recent: Array(source.recentMessages.suffix(40)),
+                                 bridgeAvailable: source.tunnelSend != nil)
+    }
+
+    private func push(_ m: CompanionMessage) {
+        guard let s = session, s.activationState == .activated, s.isPaired, s.isWatchAppInstalled else { return }
+        if s.isReachable { s.sendMessage(m.encodeToDictionary(), replyHandler: nil, errorHandler: nil) }
+        scheduleContextUpdate()
+    }
+
+    /// applicationContext is coalesced by the system; update at most every 5 s.
+    private func scheduleContextUpdate() {
+        guard contextTimer == nil else { return }
+        contextTimer = Timer.scheduledTimer(withTimeInterval: 5, repeats: false) { [weak self] _ in
+            MainActor.assumeIsolated {
+                guard let self = self else { return }
+                self.contextTimer = nil
+                try? self.session?.updateApplicationContext(CompanionMessage.snapshot(self.snapshot()).encodeToDictionary())
+            }
+        }
+    }
+
+    private func handle(_ m: CompanionMessage) {
+        switch m {
+        case .requestSnapshot:
+            push(.snapshot(snapshot()))
+        case .sendRoom(let c, let text, let clientID):
+            let sent: UnifiedMessage? = c.network == .channel ? channels.send(text, idHex: c.key) : source.sendPublic(text)
+            push(.delivery(messageID: clientID, state: sent == nil ? .failed : .sent))
+        case .sendDirect(let peer, let text, let clientID):
+            let sent = source.sendPrivate(text, peerKey: peer)
+            push(.delivery(messageID: clientID, state: sent == nil ? .failed : .sent))
+        case .joinChannel(let code, let bridge):
+            if channels.join(code: code, bridge: bridge) == nil { push(.error("channel code too short")) }
+        case .leaveChannel(let id): channels.leave(idHex: id)
+        case .setChannelBridge(let id, let on): channels.setBridge(idHex: id, enabled: on)
+        case .toggleFavorite(let peer): source.toggleFavorite(peerKey: peer)
+        default: break
+        }
+    }
+}
+
+extension WatchBridgeHub: WCSessionDelegate {
+    nonisolated func session(_ session: WCSession, activationDidCompleteWith state: WCSessionActivationState, error: Error?) {
+        Task { @MainActor in self.scheduleContextUpdate() }
+    }
+    nonisolated func sessionDidBecomeInactive(_ session: WCSession) {}
+    nonisolated func sessionDidDeactivate(_ session: WCSession) { session.activate() } // watch switched
+    nonisolated func sessionReachabilityDidChange(_ session: WCSession) {
+        guard session.isReachable else { return }
+        Task { @MainActor in self.push(.snapshot(self.snapshot())) }
+    }
+    nonisolated func session(_ session: WCSession, didReceiveMessage message: [String: Any]) {
+        guard let m = CompanionMessage.decode(fromDictionary: message) else { return }
+        Task { @MainActor in self.handle(m) }
+    }
+    nonisolated func session(_ session: WCSession, didReceiveUserInfo userInfo: [String: Any] = [:]) {
+        guard let m = CompanionMessage.decode(fromDictionary: userInfo) else { return }
+        Task { @MainActor in self.handle(m) }
+    }
+}
diff --git a/localPackages/WatchBridgeKit/Sources/WatchBridgeKit/WatchBridgePublic.swift b/localPackages/WatchBridgeKit/Sources/WatchBridgeKit/WatchBridgePublic.swift
new file mode 100644
index 0000000..2c127f3
--- /dev/null
+++ b/localPackages/WatchBridgeKit/Sources/WatchBridgeKit/WatchBridgePublic.swift
@@ -0,0 +1,100 @@
+//
+// WatchBridgePublic.swift — public façade of the WatchBridgeKit package
+//
+// Only this file is public. It lets the upstream bitchat iOS app (which has
+// its own ConversationID, TransportConfig, SecureLogger, … types) use the
+// bridge without any symbol collisions: everything else in the package is
+// internal. Used only when building the upstream patch (scripts/make-upstream-patch.sh);
+// the standalone host target compiles the generic files directly.
+//
+// SPDX-License-Identifier: GPL-3.0-or-later
+//
+
+import Foundation
+
+public struct WBPerson: Equatable {
+    public let key: String          // bitchat peer ID hex
+    public let name: String
+    public let detail: String
+    public let online: Bool
+    public let favorite: Bool
+    public let secure: Bool
+    public init(key: String, name: String, detail: String, online: Bool, favorite: Bool, secure: Bool) {
+        self.key = key; self.name = name; self.detail = detail; self.online = online; self.favorite = favorite; self.secure = secure
+    }
+}
+
+public struct WBMessage: Equatable {
+    public enum State: String { case sending, sent, delivered, read, failed, received }
+    public let id: String
+    /// nil = public mesh room, otherwise the DM peer's ID hex.
+    public let directPeerKey: String?
+    public let senderName: String
+    public let senderKey: String
+    public let text: String
+    public let timestamp: Date
+    public let outgoing: Bool
+    public let state: State
+    public init(id: String, directPeerKey: String?, senderName: String, senderKey: String, text: String,
+                timestamp: Date, outgoing: Bool, state: State) {
+        self.id = id; self.directPeerKey = directPeerKey; self.senderName = senderName; self.senderKey = senderKey
+        self.text = text; self.timestamp = timestamp; self.outgoing = outgoing; self.state = state
+    }
+}
+
+@MainActor
+public protocol WatchBridgeChatSource: AnyObject {
+    var bridgeNickname: String { get }
+    var bridgePeople: [WBPerson] { get }
+    var bridgeRecentMessages: [WBMessage] { get }
+    func bridgeSendPublic(_ text: String) -> WBMessage?
+    func bridgeSendPrivate(_ text: String, peerKey: String) -> WBMessage?
+    func bridgeToggleFavorite(peerKey: String)
+    /// Broadcast an opaque channel-tunnel payload into the mesh (nil = unsupported).
+    var bridgeTunnelSend: ((Data, UInt8) -> Void)? { get }
+}
+
+@MainActor
+public final class WatchBridge {
+    private let adapter: SourceAdapter
+    private let hub: WatchBridgeHub
+
+    public init(source: WatchBridgeChatSource) {
+        adapter = SourceAdapter(source)
+        hub = WatchBridgeHub(source: adapter)
+    }
+
+    public func start() { hub.start() }
+    /// Call for every new mesh/DM message the phone sees (incoming or local echo).
+    public func didReceive(_ m: WBMessage) { adapter.onMessage?(SourceAdapter.convert(m)) }
+    public func peopleDidChange() { adapter.onPeopleChanged?() }
+    /// Call with the payload of every received bitchat packet of type 0x7E.
+    public func didReceiveTunnel(_ payload: Data, fromPeer peer: String) { adapter.onTunnelReceive?(payload, peer) }
+    public static let tunnelPacketType: UInt8 = ChannelTunnelWire.bitchatPacketType
+}
+
+@MainActor
+final class SourceAdapter: CompanionChatSource {
+    let src: WatchBridgeChatSource
+    var onMessage: ((UnifiedMessage) -> Void)?
+    var onPeopleChanged: (() -> Void)?
+    var onTunnelReceive: ((Data, String) -> Void)?
+    init(_ s: WatchBridgeChatSource) { src = s }
+
+    var nickname: String { src.bridgeNickname }
+    var people: [UnifiedPerson] {
+        src.bridgePeople.map { UnifiedPerson(network: .bitchatPhone, key: $0.key, displayName: $0.name, detail: $0.detail,
+                                             isOnline: $0.online, isFavorite: $0.favorite, canMessage: true, secureSession: $0.secure) }
+    }
+    var recentMessages: [UnifiedMessage] { src.bridgeRecentMessages.map(SourceAdapter.convert) }
+    func sendPublic(_ text: String) -> UnifiedMessage? { src.bridgeSendPublic(text).map(SourceAdapter.convert) }
+    func sendPrivate(_ text: String, peerKey: String) -> UnifiedMessage? { src.bridgeSendPrivate(text, peerKey: peerKey).map(SourceAdapter.convert) }
+    func toggleFavorite(peerKey: String) { src.bridgeToggleFavorite(peerKey: peerKey) }
+    var tunnelSend: ((Data, UInt8) -> Void)? { src.bridgeTunnelSend }
+
+    static func convert(_ m: WBMessage) -> UnifiedMessage {
+        UnifiedMessage(id: m.id, conversation: m.directPeerKey.map { .direct(.bitchatPhone, $0) } ?? .room(.bitchatPhone, "public"),
+                       senderName: m.senderName, senderKey: m.senderKey, text: m.text, timestamp: m.timestamp,
+                       outgoing: m.outgoing, state: DeliveryState(rawValue: m.state.rawValue) ?? .received)
+    }
